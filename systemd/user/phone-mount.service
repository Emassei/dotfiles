[Unit]
Description=Auto-mount Samsung phone via simple-mtpfs
After=default.target
# Without a limit, Restart=on-failure retries every 3s forever when no phone
# is plugged in, which spams the journal. Give up after 5 tries per minute.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=forking
ExecStartPre=-/bin/fusermount -u %h/phone
ExecStart=/usr/bin/simple-mtpfs --device 1 %h/phone -o allow_other
ExecStop=/bin/fusermount -u %h/phone
Restart=on-failure
RestartSec=3
# Give the phone time to be unlocked / switched to MTP mode
TimeoutStartSec=30

[Install]
WantedBy=default.target
