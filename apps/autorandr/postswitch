#!/bin/sh
# Runs after every autorandr profile switch (as ernie, from the systemd hook).
# Route audio to match the display profile:
#   docked -> HDMI (dock monitor speakers), lid may be closed
#   mobile -> laptop speakers + mic
# PulseAudio's own port switching won't move to HDMI on its own because the
# analog profile has a higher priority, and ~/.config/pulse/default.pa forces
# analog at startup, so this hook is what selects HDMI when docked.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
CARD=alsa_card.pci-0000_00_1f.3
case "$AUTORANDR_CURRENT_PROFILE" in
    *docked)
        pactl set-card-profile "$CARD" output:hdmi-stereo+input:analog-stereo 2>/dev/null \
            || pactl set-card-profile "$CARD" output:hdmi-stereo 2>/dev/null
        pactl set-default-sink alsa_output.pci-0000_00_1f.3.hdmi-stereo 2>/dev/null
        ;;
    *mobile)
        pactl set-card-profile "$CARD" output:analog-stereo+input:analog-stereo 2>/dev/null
        pactl set-default-sink alsa_output.pci-0000_00_1f.3.analog-stereo 2>/dev/null
        ;;
esac
# move anything already playing onto the new default sink
for i in $(pactl list short sink-inputs 2>/dev/null | cut -f1); do
    pactl move-sink-input "$i" @DEFAULT_SINK@ 2>/dev/null
done
exit 0
