#!/bin/sh

# Prints the volume of the DEFAULT PipeWire sink, or 🔇 if muted.
# Reads wpctl, not `amixer get Master` — while docked, the laptop's ALSA
# Master has nothing to do with what you're actually listening through.

case $BLOCK_BUTTON in
	1) setsid -f "$TERMINAL" -e pulsemixer ;;                       # debug UI: live meters, arrow keys to switch
	2) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
	3) notify-send "📢 Volume module" "Default sink: $(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | sed -n 's/.*node.description = "\(.*\)"/\1/p')
Default source: $(wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | sed -n 's/.*node.description = "\(.*\)"/\1/p')

- Left click: pulsemixer (meters + device switching)
- Middle click: mute
- Scroll: volume
- Shift+click: full wpctl status" ;;
	4) wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;;
	5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
	6) "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED && { printf "🔇\\n"; exit; }

# "Volume: 0.52" -> 52
vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null \
	| awk '{printf "%d", $2 * 100}')
[ -z "$vol" ] && { printf "🔇\\n"; exit; }

if [ "$vol" -gt 70 ]; then
	icon="🔊"
elif [ "$vol" -lt 30 ]; then
	icon="🔈"
else
	icon="🔉"
fi

printf "%s%s%%\\n" "$icon" "$vol"
