#!/bin/bash
# Fuzzy-jump to any herdr workspace or agent (bound to alt+p as a popup).
# Workspaces list first (numbered, like the alt+1..9 tags), then every
# agent with its workspace and status. Picking a line focuses it.
HERDR="$HOME/.local/bin/herdr"

pick=$("$HERDR" api snapshot | jq -r '
  .result.snapshot as $s
  | ($s.workspaces | map({(.workspace_id): .label}) | add) as $wl
  | ( $s.workspaces[]
      | ["ws", .workspace_id, "", "",
         "\(.number)  \(.label)  (\(.tab_count) tabs)"] ),
    ( $s.tabs[]
      | ["tab", .workspace_id, .tab_id, "",
         "   ›  \($wl[.workspace_id] // .workspace_id)  ›  \(.label // .tab_id)"] ),
    ( $s.agents[]
      | ["ag", .workspace_id, .tab_id, .pane_id,
         "→ \(.agent) [\(.agent_status)]  \($wl[.workspace_id] // .workspace_id)  \(.cwd | split("/") | last)"] )
  | @tsv' \
  | fzf --delimiter='\t' --with-nth=5 --no-multi \
        --prompt='jump ▸ ' --info=hidden --layout=reverse)

[ -n "$pick" ] || exit 0
IFS=$'\t' read -r kind ws tab pane _ <<<"$pick"
# Focus workspace → tab → pane in order. Focusing only the agent lands on the
# workspace's *active* tab, not the agent's tab, in multi-tab workspaces.
"$HERDR" workspace focus "$ws" >/dev/null 2>&1
[ -n "$tab" ]  && "$HERDR" tab focus "$tab" >/dev/null 2>&1
[ -n "$pane" ] && exec "$HERDR" agent focus "$pane"
exit 0
