#!/bin/bash
# plane — use herdr from the tablet while the t490 is closed under the seat.
#
#   plane on      lid-close no longer suspends, turbo off (cool + quiet),
#                 Wi-Fi becomes hotspot "t490" (no internet needed), ssh
#                 allowed in on it. Prints the hotspot password and the
#                 command to run on the tablet.
#   plane off     undo all of it, reconnect Wi-Fi as a client.
#   plane status  what's currently on.
#
# Tablet side (Termux):  ssh -t ernie@10.42.0.1 herdr
# Tailscale isn't involved — the hotspot is a private LAN of two devices.
set -e
IF=wlp0s20f3; CON=t490-hotspot; AP_IP=10.42.0.1
RUN=${XDG_RUNTIME_DIR:-/tmp}; PID=$RUN/plane-inhibit.pid; TURBO=$RUN/plane-turbo.prev
NFT_COMMENT="plane-mode ssh on hotspot"
G='\033[0;32m'; N='\033[0m'; say(){ echo -e "${G}[plane]${N} $1"; }

nft_rule_handle(){ sudo -n nft -a list chain inet lockdown input 2>/dev/null | grep -F "$NFT_COMMENT" | grep -oE 'handle [0-9]+' | awk '{print $2}'; }

case "${1:-status}" in
on)
  # 1. keep running with the lid closed (inhibitor lock, no logind restart needed)
  if [ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then say "lid inhibitor already running"; else
    systemd-inhibit --what=handle-lid-switch:sleep:idle --who=plane --why="t490 is under the seat, tablet is the screen" sleep infinity >/dev/null 2>&1 &
    echo $! > "$PID"; say "lid-close will NOT suspend (inhibitor pid $!)"
  fi
  # 2. cool: no turbo while it's in a bag
  cat /sys/devices/system/cpu/intel_pstate/no_turbo > "$TURBO"
  echo 1 | sudo -n tee /sys/devices/system/cpu/intel_pstate/no_turbo >/dev/null && say "turbo off"
  # 3. hotspot (profile is created on first use, so a rebuilt box just works)
  if ! nmcli -t -f NAME con show | grep -qx "$CON"; then
    psk=$(head -c 24 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 14)
    nmcli con add type wifi ifname "$IF" con-name "$CON" autoconnect no ssid t490 802-11-wireless.mode ap \
      802-11-wireless.band bg ipv4.method shared ipv6.method disabled wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$psk" >/dev/null
    say "created hotspot profile $CON (needs the dnsmasq package)"
  fi
  nmcli -t -f NAME,DEVICE con show --active | grep -q "^$CON:" || { nmcli con up "$CON" >/dev/null && say "hotspot up: ssid t490"; }
  # 4. let ssh in on the hotspot interface (temporary rule, removed by 'off')
  [ -n "$(nft_rule_handle)" ] || sudo -n nft add rule inet lockdown input iifname "$IF" tcp dport 22 accept comment "\"$NFT_COMMENT\""
  say "ssh accepted on $IF"
  echo
  echo "  hotspot:   t490   password: $(nmcli -s -g 802-11-wireless-security.psk con show "$CON")"
  echo "  on tablet: ssh -t ernie@$AP_IP herdr"
  echo "  battery:   $(cat /sys/class/power_supply/BAT0/capacity)%   close the lid whenever."
  ;;
off)
  h=$(nft_rule_handle); [ -n "$h" ] && sudo -n nft delete rule inet lockdown input handle "$h" && say "ssh rule removed"
  nmcli -t -f NAME con show --active | grep -qx "$CON" && nmcli con down "$CON" >/dev/null && say "hotspot down"
  # don't force a reconnect ("dev connect" re-picks the hotspot profile);
  # NM autoconnects to a known network on its own once the device is free.
  for _ in 1 2 3 4 5 6; do sleep 2; c=$(nmcli -t -f NAME,DEVICE con show --active | awk -F: -v i="$IF" '$2==i{print $1}'); [ -n "$c" ] && { say "wifi back as client: $c"; break; }; done
  [ -n "$c" ] || say "wifi: no known network here (fine)"
  if [ -s "$TURBO" ]; then echo "$(cat "$TURBO")" | sudo -n tee /sys/devices/system/cpu/intel_pstate/no_turbo >/dev/null; rm -f "$TURBO"; say "turbo restored"; fi
  if [ -s "$PID" ]; then kill "$(cat "$PID")" 2>/dev/null; rm -f "$PID"; say "lid-close suspends again"; fi
  ;;
status)
  [ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && echo "inhibitor: on" || echo "inhibitor: off"
  echo "turbo disabled: $(cat /sys/devices/system/cpu/intel_pstate/no_turbo)"
  nmcli -t -f NAME con show --active | grep -qx "$CON" && echo "hotspot: up ($AP_IP)" || echo "hotspot: down"
  [ -n "$(nft_rule_handle)" ] && echo "ssh on hotspot: allowed" || echo "ssh on hotspot: blocked"
  echo "battery: $(cat /sys/class/power_supply/BAT0/capacity)% ($(cat /sys/class/power_supply/BAT0/status))"
  ;;
*) echo "usage: plane on|off|status"; exit 1 ;;
esac
