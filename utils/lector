#!/usr/bin/env python3
"""lector — terminal reader for Spanish books, with an AI tutor.

Plain-text books, read full-screen in the house style. Press `i` on any
paragraph to open a Claude chat seeded with that passage as a Spanish
tutor. Books come from local files or Project Gutenberg (fetched once,
kept in ~/.local/share/lector).

Usage:
  lector                     resume the last book, or list the library
  lector FILE.txt            read a local plain-text book
  lector -g ID [TITLE]       fetch a Gutenberg book by ebook number
  lector -b "búsqueda"       search Gutenberg's Spanish catalogue

Keys: j/k line   d/u half-page   g/G start/end   J/K párrafo
      i pregunta (AI)   q salir
"""
import curses
import json
from html import unescape as html_unescape
import os
import re
import shutil
import subprocess
import sys
import textwrap
import urllib.parse
import urllib.request

LIB = os.path.expanduser("~/.local/share/lector")
CACHE = os.path.expanduser("~/.cache/lector")
UA = {"User-Agent": "lector-reader/1.0 (personal terminal reader)"}


def fetch(url):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read()


def gutenberg_get(book_id, title=None):
    os.makedirs(LIB, exist_ok=True)
    path = os.path.join(LIB, f"gutenberg-{book_id}.txt")
    if os.path.exists(path):
        return path
    raw = fetch(f"https://www.gutenberg.org/ebooks/{book_id}.txt.utf-8")
    text = raw.decode("utf-8", errors="replace")
    if not title:
        m = re.search(r"^Title:\s*(.+)$", text, flags=re.M)
        title = m.group(1).strip() if m else f"Gutenberg #{book_id}"
    m = re.search(r"\*\*\* START OF.*?\*\*\*", text, flags=re.S)
    if m:
        text = text[m.end():]
    m = re.search(r"\*\*\* END OF", text)
    if m:
        text = text[:m.start()]
    with open(path, "w") as f:
        f.write(f"# {title}\n\n" + text.strip() + "\n")
    return path


def gutenberg_search(query):
    hits = []       # (id, title, authors)
    try:
        qs = urllib.parse.urlencode({"search": query, "languages": "es"})
        data = json.loads(fetch(f"https://gutendex.com/books?{qs}"))
        hits = [(b["id"], b["title"],
                 "; ".join(a["name"] for a in b.get("authors", [])))
                for b in data.get("results", [])[:15]]
    except (OSError, ValueError):
        pass
    if not hits:    # gutendex down or empty: Gutenberg's own OPDS feed
        qs = urllib.parse.quote(query)
        xml = fetch("https://www.gutenberg.org/ebooks/search.opds/"
                    f"?query={qs}").decode("utf-8", errors="replace")
        for e in re.findall(r"<entry>(.*?)</entry>", xml, flags=re.S)[:15]:
            bid = re.search(r"ebooks/(\d+)", e)
            title = re.search(r"<title>([^<]*)</title>", e)
            if bid and title:
                authors = "; ".join(re.findall(r"<name>([^<]*)</name>", e))
                hits.append((bid.group(1), html_unescape(title.group(1)),
                             authors))
    if not hits:
        print("nada encontrado")
        return
    for bid, title, authors in hits:
        print(f"{bid:>6}  {title}" + (f" — {authors}" if authors else ""))
    print("\nlector -g ID  para descargar")


def epub_import(path):
    """Convert an epub (for books you own) into a library .txt, spine order."""
    import html as h
    import zipfile
    with zipfile.ZipFile(path) as z:
        container = z.read("META-INF/container.xml").decode(errors="replace")
        opf_path = re.search(r'full-path="([^"]+)"', container).group(1)
        opf = z.read(opf_path).decode(errors="replace")
        root = os.path.dirname(opf_path)
        m = re.search(r"<dc:title[^>]*>([^<]+)</dc:title>", opf)
        title = h.unescape(m.group(1).strip()) if m else \
            os.path.splitext(os.path.basename(path))[0]
        manifest = {}
        for tag in re.findall(r"<item\b[^>]*>", opf):
            mid = re.search(r'id="([^"]+)"', tag)
            href = re.search(r'href="([^"]+)"', tag)
            if mid and href:
                manifest[mid.group(1)] = href.group(1)
        spine = re.findall(r'<itemref[^>]*idref="([^"]+)"', opf)
        chunks = []
        for idref in spine:
            href = manifest.get(idref)
            if not href:
                continue
            name = os.path.join(root, urllib.parse.unquote(href)) \
                if root else urllib.parse.unquote(href)
            try:
                doc = z.read(name).decode("utf-8", errors="replace")
            except KeyError:
                continue
            doc = re.sub(r"<(style|script).*?</\1>", "", doc, flags=re.S)
            doc = re.sub(r"</(p|div|h[1-6]|li|blockquote)>", "\n\n", doc)
            doc = re.sub(r"<br[^>]*>", "\n", doc)
            doc = re.sub(r"<[^>]+>", " ", doc)
            chunks.append(h.unescape(doc))
        text = re.sub(r"\n{3,}", "\n\n", "\n\n".join(chunks))
    os.makedirs(LIB, exist_ok=True)
    slug = re.sub(r"[^a-z0-9]+", "-",
                  os.path.splitext(os.path.basename(path))[0].lower())
    out = os.path.join(LIB, f"{slug}.txt")
    with open(out, "w") as f:
        f.write(f"# {title}\n\n" + text.strip() + "\n")
    return out


def load_book(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    title = os.path.basename(path)
    m = re.match(r"#\s*(.+)\n", text)
    if m:
        title = m.group(1).strip()
        text = text[m.end():]
    paras = [re.sub(r"\s+", " ", p).strip()
             for p in re.split(r"\n\s*\n", text)]
    return title, [p for p in paras if p]


def is_heading(p):
    return len(p) < 60 and (
        p.isupper()
        or re.match(r"^(cap[íi]tulo|libro|parte|prólogo|epílogo)\b", p,
                    flags=re.I)
        or re.fullmatch(r"[IVXLCDM]+\.?", p))


def state_load():
    try:
        with open(os.path.join(CACHE, "state.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"last": None, "books": {}}


def state_save(st):
    os.makedirs(CACHE, exist_ok=True)
    with open(os.path.join(CACHE, "state.json"), "w") as f:
        json.dump(st, f)


def library():
    books = []
    if os.path.isdir(LIB):
        for name in sorted(os.listdir(LIB)):
            if name.endswith(".txt"):
                path = os.path.join(LIB, name)
                title, _ = load_book(path)
                books.append((path, title))
    return books


def pick_book():
    books = library()
    if not books:
        sys.exit("biblioteca vacía — prueba: lector -b \"quijote\"")
    for i, (_, title) in enumerate(books, 1):
        print(f"{i:>3}  {title}")
    try:
        n = int(input("\n¿cuál? "))
        return books[n - 1][0]
    except (ValueError, IndexError, EOFError, KeyboardInterrupt):
        sys.exit(0)


def ai_chat(title, para):
    if not shutil.which("claude"):
        return "claude CLI not found"
    prompt = (
        f"Estoy leyendo «{title}» en un lector de terminal. "
        "Este es el pasaje donde estoy:\n\n"
        f"{para}\n\n"
        "Act as a Spanish tutor and literature guide. I'm learning modern "
        "Colombian Spanish specifically. Briefly orient me: tricky "
        "vocabulary and idioms (with English glosses), notable grammar, "
        "and context. When the text's wording is dated, regional, or "
        "peninsular, tell me how a Colombian would say it today — "
        "colombianismos welcome. Then take my questions. Habla español "
        "conmigo cuando sea útil para practicar, pero explica en inglés "
        "cuando algo sea difícil.")
    os.makedirs(LIB, exist_ok=True)
    subprocess.call(["claude", prompt], cwd=LIB)
    return None


def build_rows(paras, width):
    col = min(width - 4, 78)
    margin = max((width - col) // 2, 0)
    rows = []                        # (text, para_idx, heading)
    for i, p in enumerate(paras):
        if is_heading(p):
            rows.append((p[:col], i, True))
        else:
            for line in textwrap.wrap(p, col):
                rows.append((line, i, False))
        rows.append(("", i, False))
    return rows, col, margin


def reader(stdscr, path, top):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()
    # house palette (see utils/almanac): dark/mid/bright oxblood + gold
    if curses.COLORS >= 256:
        shades = (95, 131, 174, 178, 181)
    else:
        shades = (curses.COLOR_RED, curses.COLOR_RED, curses.COLOR_RED,
                  curses.COLOR_YELLOW, curses.COLOR_WHITE)
    for i, fg in enumerate(shades, 1):
        curses.init_pair(i, fg, -1)
    DARK, MID, BRIGHT, GOLD, WARM = (curses.color_pair(i)
                                     for i in range(1, 6))
    title, paras = load_book(path)
    msg = ""
    h, w = stdscr.getmaxyx()
    rows, col, margin = build_rows(paras, w)

    while True:
        h, w = stdscr.getmaxyx()
        body = h - 5
        top = max(0, min(top, len(rows) - body))
        cur = rows[min(top, len(rows) - 1)][1]
        stdscr.erase()
        head = f"❦ · {title[:w - 8]} · ❦"
        stdscr.addnstr(0, 0, "─" * (w - 1), w - 1, DARK)
        stdscr.addnstr(1, max(0, (w - len(head)) // 2), head, w - 1,
                       GOLD | curses.A_BOLD)
        stdscr.addnstr(2, 0, "─" * (w - 1), w - 1, DARK)
        for i in range(body):
            if top + i >= len(rows):
                break
            line, para, heading = rows[top + i]
            if not line:
                continue
            y = i + 3
            if heading:
                stdscr.addnstr(y, max(0, (w - len(line)) // 2), line, w - 1,
                               GOLD | curses.A_BOLD)
            else:
                attr = WARM | (curses.A_BOLD if para == cur else 0)
                stdscr.addnstr(y, margin, line, col, attr)
        pct = 100 * min(top + body, len(rows)) // max(1, len(rows))
        stdscr.addnstr(h - 2, 0, "─" * (w - 1), w - 1, DARK)
        foot = msg or ("‹j k› línea  ‹d u› página  ‹J K› párrafo  "
                       "‹g G› inicio/fin  ‹i› pregunta  ‹q› salir")
        stdscr.addnstr(h - 1, max(0, (w - len(foot)) // 2), foot, w - 1,
                       MID if msg else DARK)
        stdscr.addnstr(h - 1, max(0, w - 6), f"{pct:3d}%", 5, GOLD)
        msg = ""
        stdscr.refresh()

        c = stdscr.getch()
        if c in (ord("q"), 27):
            return top
        elif c in (ord("j"), curses.KEY_DOWN):
            top += 1
        elif c in (ord("k"), curses.KEY_UP):
            top -= 1
        elif c in (ord("d"), curses.KEY_NPAGE, ord(" ")):
            top += body // 2
        elif c in (ord("u"), curses.KEY_PPAGE):
            top -= body // 2
        elif c == ord("g"):
            top = 0
        elif c == ord("G"):
            top = len(rows)
        elif c == ord("J"):
            nxt = [i for i, r in enumerate(rows) if r[1] == cur + 1]
            top = nxt[0] if nxt else top
        elif c == ord("K"):
            prv = [i for i, r in enumerate(rows) if r[1] == max(0, cur - 1)]
            top = prv[0] if prv else top
        elif c == ord("i"):
            curses.endwin()
            msg = ai_chat(title, paras[cur]) or ""
        elif c == curses.KEY_RESIZE:
            rows, col, margin = build_rows(paras, w)


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-b", "--buscar"):
        gutenberg_search(" ".join(args[1:]))
        return
    if args and args[0] in ("-g", "--gutenberg"):
        path = gutenberg_get(args[1], " ".join(args[2:]) or None)
    elif args:
        path = os.path.abspath(args[0])
        if not os.path.exists(path):
            sys.exit(f"lector: no existe {path}")
        if path.lower().endswith(".epub"):
            path = epub_import(path)
    else:
        st = state_load()
        path = st["last"] if st["last"] and os.path.exists(st["last"]) \
            else pick_book()
    st = state_load()
    top = st["books"].get(path, 0)
    top = curses.wrapper(reader, path, top)
    st["last"] = path
    st["books"][path] = top
    state_save(st)


if __name__ == "__main__":
    main()
