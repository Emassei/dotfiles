#!/bin/bash
# ripcord — turn a fresh Arch box (from system/archinstall/install.py) into
# Ernie's machine. Run as ernie after the first boot. Idempotent.
#   1. tailscale up            (the vault is tailnet-only)
#   2. restore ~ from the vault (code, .ssh, .config, agent history, secrets)
#   3. deploy                  (packages, dwm fork, links, units)
#   4. YubiKey LUKS enrollment (if install.py couldn't — key wasn't plugged in)
# `ripcord --from-s3` restores from the offsite S3 copy instead of the Pi.
set -e
G='\033[0;32m'; Y='\033[1;33m'; N='\033[0m'; info(){ echo -e "${G}[ripcord]${N} $1"; }; warn(){ echo -e "${Y}[ripcord]${N} $1"; }
[ "$(id -u)" -eq 0 ] && { echo "run as ernie, not root"; exit 1; }
VAULT=rest:http://100.93.44.40:8000/t490
# --from-s3: the Pi is gone too — restore from the offsite copy (see
# system/vault-offsite/README.md). Needs an access key for the bucket: the
# vault-offsite user's key (only on the Pi) or a fresh one minted in the IAM
# console of the personal AWS account. Same repo password as the vault.
FROM_S3=; [ "$1" = "--from-s3" ] && FROM_S3=1

if [ -n "$FROM_S3" ]; then
  info "1/4 offsite mode: restoring from S3 (massei-vault-offsite), tailscale not needed"
  # break-glass script (KeePass attachment) exports these; otherwise prompt
  [ -n "$AWS_ACCESS_KEY_ID" ]     || read -rp  "AWS access key id (vault-offsite user, or a new key from IAM): " AWS_ACCESS_KEY_ID
  [ -n "$AWS_SECRET_ACCESS_KEY" ] || { read -rsp "AWS secret access key: " AWS_SECRET_ACCESS_KEY; echo; }
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION=us-east-1
  VAULT=s3:s3.us-east-1.amazonaws.com/massei-vault-offsite/vault/t490
else
info "1/4 tailscale (needed to reach the vault)"
if [ -n "$RIPCORD_SKIP_TAILSCALE" ]; then warn "RIPCORD_SKIP_TAILSCALE set (rehearsal) — assuming the vault is reachable via the host"
else
  sudo systemctl enable --now tailscaled
  tailscale status >/dev/null 2>&1 || sudo tailscale up
fi
until ping -c1 -W2 100.93.44.40 >/dev/null 2>&1; do warn "waiting to reach the vault (approve tailscale on your phone)..."; sleep 5; done
fi

info "2/4 restore home from the vault"
if [ -n "$RIPCORD_SKIP_RESTORE" ] || ls ~/.ssh/id_* >/dev/null 2>&1; then
  warn "home already seeded (ssh keys present — e.g. via utils/handoff from the old laptop); skipping the vault restore"
  SKIP_RESTORE=1
fi
if [ -z "$SKIP_RESTORE" ]; then
mkdir -p ~/.config/restic && chmod 700 ~/.config/restic
if [ ! -s ~/.config/restic/password ]; then
  if [ -n "$VAULT_PASSWORD" ]; then p=$VAULT_PASSWORD; else read -rsp "vault password (KeePass): " p; echo; fi
  printf '%s' "$p" > ~/.config/restic/password; chmod 600 ~/.config/restic/password; unset p
fi
export RESTIC_REPOSITORY=$VAULT RESTIC_PASSWORD_FILE=$HOME/.config/restic/password
restic snapshots --latest 1 --compact
# first the small, essential bits so deploy can talk to GitHub; the bulk after
restic restore latest --target / --include "$HOME/.ssh" --include "$HOME/.config/zsh" --include "$HOME/.config/restic" --include "$HOME/.claude" --include "$HOME/.codex"
chmod 700 ~/.ssh; chmod 600 ~/.ssh/* 2>/dev/null || true
if [ -n "$RIPCORD_KEEP_KEY" ]; then grep -qF "$RIPCORD_KEEP_KEY" ~/.ssh/authorized_keys 2>/dev/null || echo "$RIPCORD_KEEP_KEY" >> ~/.ssh/authorized_keys; fi  # rehearsal: keep the harness key
if [ -n "$RIPCORD_ESSENTIALS_ONLY" ]; then warn "RIPCORD_ESSENTIALS_ONLY set (rehearsal) — skipping the bulk home restore"
else
  warn "full home restore (code, media, everything) runs in the background — hours over the Pi link"
  nohup restic restore latest --target / --include "$HOME" > ~/ripcord-restore.log 2>&1 &
fi
fi  # SKIP_RESTORE

info "3/4 deploy"
[ -d ~/dotfiles/.git ] || git clone git@github.com:Emassei/dotfiles.git ~/dotfiles
git -C ~/dotfiles remote set-url origin git@github.com:Emassei/dotfiles.git
~/dotfiles/deploy --yes

info "4/4 LUKS: is the YubiKey enrolled?"
LUKS=$(lsblk -rno NAME,FSTYPE | awk '$2=="crypto_LUKS"{print "/dev/"$1; exit}')
if sudo cryptsetup luksDump "$LUKS" | grep -q systemd-fido2; then
  info "key is enrolled in LUKS"
  # archinstall's LVM path doesn't always put the fido2 option on the cmdline — make sure it's there
  UUID=$(sudo cryptsetup luksUUID "$LUKS")
  if ! grep -q 'fido2-device=auto' /etc/default/grub; then
    warn "GRUB cmdline lacks fido2-device=auto — adding it"
    sudo sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"|GRUB_CMDLINE_LINUX_DEFAULT=\"\1 rd.luks.options=$UUID=fido2-device=auto\"|" /etc/default/grub
    sudo grub-mkconfig -o /boot/grub/grub.cfg
  fi
  grep -q sd-encrypt /etc/mkinitcpio.conf || warn "mkinitcpio HOOKS lack sd-encrypt — see system/luks-fido2/README.md"
  info "boot will ask for the key (fallback: passphrase)"
else
  if systemd-cryptenroll --fido2-device=list 2>/dev/null | grep -q /dev; then
    info "YubiKey present — enrolling it now (you'll type the LUKS passphrase, then touch the key)"
    sudo systemd-cryptenroll --fido2-device=auto "$LUKS"
    UUID=$(sudo cryptsetup luksUUID "$LUKS")
    # installed without a key => udev hooks (encrypt, cryptdevice=). Convert to the systemd set that supports fido2.
    if grep -q '^HOOKS=.*[( ]encrypt[ )]' /etc/mkinitcpio.conf; then
      info "converting initramfs hooks udev/encrypt -> systemd/sd-encrypt"
      sudo sed -i -E '/^HOOKS=/{s/\budev\b/systemd/; s/\bkeymap consolefont\b/sd-vconsole/; s/\bkeymap\b/sd-vconsole/; s/\bconsolefont\b//; s/\bencrypt\b/sd-encrypt/; s/  +/ /g}' /etc/mkinitcpio.conf
      grep '^HOOKS' /etc/mkinitcpio.conf
      sudo mkinitcpio -P
    fi
    if grep -q 'cryptdevice=' /etc/default/grub; then
      sudo sed -i -E "s|cryptdevice=UUID=[^:]+:([a-z]+)|rd.luks.name=$UUID=\1 rd.luks.options=$UUID=fido2-device=auto|" /etc/default/grub
      sudo grub-mkconfig -o /boot/grub/grub.cfg
    fi
    info "done — reboot will ask for the key (fallback: passphrase)"
  else warn "not enrolled and no key plugged in — later: plug it in and run: sudo ~/dotfiles/system/luks-fido2/enroll-luks-yubikey $LUKS"; fi
fi

info "done. 'startx' for dwm. Background restore log: ~/ripcord-restore.log"
