#!/bin/sh
# Copy the vault's three credential files from pivault to the t420.
#
# Run this yourself - it moves live S3 keys and a repo password. Content goes
# pivault -> your ssh -> t420 and straight to disk: no temp files, nothing in
# a shell history, never world-readable (install(1) sets owner+mode in one
# step).
#
# Idempotent: anything already present on the t420 is left alone. Pass -f to
# overwrite.
#
# You will be prompted for sudo on both ends; -t gives ssh a TTY so it can ask.

set -e

SRC=pivault
DST=t420
force=0
[ "$1" = "-f" ] && force=1

say() { printf '\n== %s\n' "$1"; }

# $1 remote path on both ends, $2 "root" or "user"
copy() {
	path=$1 kind=$2
	case "$kind" in
		root) exists="sudo test -e $path" ;;
		user) exists="test -e $path" ;;
	esac

	if ssh -o ConnectTimeout=8 -t "$DST" "$exists" 2>/dev/null; then
		if [ "$force" -eq 0 ]; then
			echo "SKIP  $path already on $DST (use -f to overwrite)"
			return 0
		fi
		echo "OVERWRITING $path on $DST"
	fi

	case "$kind" in
	root)
		ssh -o ConnectTimeout=8 -t "$SRC" "sudo cat $path" \
			| ssh -o ConnectTimeout=8 -t "$DST" "sudo install -m600 -o root -g root /dev/stdin $path"
		;;
	user)
		# $path contains a literal $HOME - expand it remotely, and derive the
		# directory there too, so nothing depends on this machine's shell.
		ssh -o ConnectTimeout=8 "$DST" "mkdir -p \"\$(dirname $path)\""
		ssh -o ConnectTimeout=8 "$SRC" "cat $path" \
			| ssh -o ConnectTimeout=8 "$DST" "install -m600 /dev/stdin $path"
		;;
	esac
	echo "OK    $path"
}

say "rclone S3 config (used by vault-offsite-sync)"
copy /etc/rclone-offsite.conf root

say "restic AWS env (used by vault-offsite-check)"
copy /etc/restic-offsite.env root

say "restic password for the rescued repo"
copy "\$HOME/.config/restic/password-rescued" user

say "verifying on $DST (modes and owners only, no contents)"
ssh -o ConnectTimeout=8 -t "$DST" '
	sudo ls -l /etc/rclone-offsite.conf /etc/restic-offsite.env 2>&1
	ls -l "$HOME/.config/restic/password-rescued" 2>&1
'

cat <<'NOTE'

Expect -rw------- root root on the two /etc files and -rw------- ernie ernie
on the password file.

Both machines now hold live AWS credentials. That is correct while the Pi is
your rollback - but wipe the Pi once the t420 has proven a restore, rather
than leaving it on a shelf with working keys.
NOTE
