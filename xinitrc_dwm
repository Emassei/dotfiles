#!/bin/sh

# startx sessions inherit XDG_SESSION_TYPE=tty. Claim x11 explicitly so
# portal-aware apps know what they're on. NOTE: this is NOT what fixes
# flameshot 14+ — it uses the screenshot portal by default on any session
# type, and the gtk portal backend hangs on X11 without GNOME. The real fix
# is useX11LegacyScreenshot=true in ~/.config/flameshot/flameshot.ini
# (seeded from apps/flameshot by deploy).
export XDG_SESSION_TYPE=x11

# Monitor layout: autorandr handles dock/undock profiles.
# Save a profile from a working layout with:  autorandr --save <name>
# To re-apply on the fly mid-session:         autorandr --change
autorandr --change --default docked 2>/dev/null || true
# Then correct for lid state: booting docked with the lid OPEN means dual
# head, which autorandr can't express (lid state isn't in its fingerprint).
# twoscreens is also what the acpid lid hook fires on open/close.
$HOME/dotfiles/utils/twoscreens 2>/dev/null || true

systemctl --user import-environment DISPLAY XAUTHORITY GTK_USE_PORTAL XDG_SESSION_TYPE
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY GTK_USE_PORTAL XDG_SESSION_TYPE

setxkbmap -option "caps:swapescape"
xbindkeys -f $HOME/dotfiles/xbindkeys
xrdb -merge $HOME/.Xresources
feh --bg-fill --randomize --no-fehbg ~/media/pictures/wallpaper/* &
flameshot &
dunst &
picom &
# clipmenud disabled — was causing Brave paste freezes (form fields)
# clipmenud &
greenclip daemon &
$HOME/dotfiles/utils/quakewatch &
$HOME/dotfiles/utils/battwatch &
kdeconnectd &
dwm

