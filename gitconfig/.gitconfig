[push]
	default = current
[user]
	email = Emassei@users.noreply.github.com
	name = Ernie Massei
[diff]
   tool = vimdiff
[difftool]
   prompt = false
[alias]
   d = difftool
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
